<apex:page controller="PublicApprovalController" showHeader="false" sidebar="false" lightningStylesheets="true" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0">
    
    <style>
        body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f4f6f9; }
        .container { max-width: 600px; margin: 60px auto; background: white; padding: 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); text-align: center; }
        h1 { color: #2c3e50; margin-bottom: 10px; font-size: 24px; }
        p { color: #7f8c8d; font-size: 16px; margin-bottom: 30px; }
        
        /* Button Styles */
        .btn-custom { padding: 12px 30px; border: none; margin: 10px; cursor: pointer; font-size: 16px; font-weight: 600; border-radius: 50px; transition: all 0.3s ease; box-shadow: 0 4px 6px rgba(0,0,0,0.1); min-width: 140px; }
        .btn-custom:hover { transform: translateY(-2px); box-shadow: 0 6px 12px rgba(0,0,0,0.15); }
        .btn-approve { background: linear-gradient(135deg, #4bca81 0%, #2e844a 100%); color: white; }
        .btn-reject { background: linear-gradient(135deg, #ff7675 0%, #d63031 100%); color: white; }
        .btn-cancel { background: #dfe6e9; color: #636e72; }
        .btn-confirm { background: #d63031; color: white; }
        
        /* Inputs */
        .reject-box { margin-top: 20px; animation: fadeIn 0.5s; }
        .reason-input { width: 90%; padding: 15px; border: 2px solid #dfe6e9; border-radius: 8px; font-size: 14px; resize: vertical; outline: none; transition: border-color 0.3s; }
        .reason-input:focus { border-color: #ff7675; }

        @keyframes fadeIn { from { opacity:0; transform: translateY(10px); } to { opacity:1; transform: translateY(0); } }
        .success-icon { font-size: 60px; color: #4bca81; margin-bottom: 20px; display:block;}
        .reject-icon { font-size: 60px; color: #d63031; margin-bottom: 20px; display:block;}
        .error-msg { background-color: #fee; color: #c0392b; padding: 15px; border-radius: 8px; border: 1px solid #fcc; margin-top: 20px; }
    </style>

    <script>
        window.onload = function() {
            const urlParams = new URLSearchParams(window.top.location.search);
            const myId = urlParams.get('id');
            if (myId) { passIdToController(myId); }
        };
    </script>

    <div class="container">
        <apex:outputPanel id="mainPanel">
            
            <apex:form >
                <apex:actionFunction name="passIdToController" action="{!setRecordIdFromClient}" reRender="mainPanel">
                    <apex:param name="pId" value="" />
                </apex:actionFunction>

                <apex:actionStatus id="btnStatus">
                    <apex:facet name="start"><p style="color:#0984e3; font-weight:bold;">Processing...</p></apex:facet>
                </apex:actionStatus>

                <apex:outputPanel rendered="{!AND(NOT(approved), NOT(rejected), NOT(isRejecting))}">
                    <h1>Approval Request</h1>
                    <p>Please review the quotation document and Payment Terms sent to your email.</p>
                    
                    <apex:commandButton value="Approve" action="{!doApprove}" reRender="mainPanel" status="btnStatus" styleClass="btn-custom btn-approve"/>
                    <apex:commandButton value="Reject" action="{!enableRejectMode}" reRender="mainPanel" status="btnStatus" styleClass="btn-custom btn-reject"/>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!isRejecting}" layout="block" styleClass="reject-box">
                    <h1>Reason for Rejection</h1>
                    <p>Please let us know why you are rejecting.</p>
                    
                    <apex:inputTextarea value="{!rejectionReason}" styleClass="reason-input" rows="4" html-placeholder="Enter reason here..."/>
                    <br/><br/>
                    
                    <apex:commandButton value="Confirm Reject" action="{!doConfirmReject}" reRender="mainPanel" status="btnStatus" styleClass="btn-custom btn-confirm"/>
                    <apex:commandButton value="Cancel" action="{!cancelRejectMode}" reRender="mainPanel" immediate="true" styleClass="btn-custom btn-cancel"/>
                </apex:outputPanel>
            </apex:form>

            <apex:outputPanel rendered="{!approved}" style="animation: fadeIn 0.5s;">
                <span class="success-icon">✔</span>
                <h1>Successfully Approved</h1>
                <p>Thank you. The quotation and payment terms has been approved.</p>
            </apex:outputPanel>

            <apex:outputPanel rendered="{!rejected}" style="animation: fadeIn 0.5s;">
                <span class="reject-icon">✘</span>
                <h1> Rejected </h1>
                <p>You have rejected . The feedback has been recorded.</p>
            </apex:outputPanel>
            
            <apex:outputPanel rendered="{!hasError}">
               <div class="error-msg">{!errorMessage}</div>
            </apex:outputPanel>

        </apex:outputPanel>
    </div>
</apex:page>